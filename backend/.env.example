# ==========================================
# MailMind AI - Backend Environment Variables
# ==========================================

# Server Configuration
PORT=8000
HOST=0.0.0.0
APP_ENV=development
FRONTEND_URL=http://localhost:5173

# Database
DATABASE_URL=sqlite:///./mailmind.db

# ==========================================
# Google OAuth 2.0 & Gmail API Configuration
# ==========================================
# Create credentials in Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
# Ensure Gmail API is enabled and OAuth consent screen is configured.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# ==========================================
# AI Configuration (Optional with Rule-Based Fallback)
# ==========================================
# If omitted or left empty, MailMind AI gracefully uses its intelligent
# rule-based fallback heuristics engine.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Optional OpenAI-compatible key:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_PROVIDER=gemini
